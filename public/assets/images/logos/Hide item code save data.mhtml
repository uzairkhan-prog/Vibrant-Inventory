// Fetch last serial number from invoices table
$stmt =3D $pdo-&gt;query("SELECT serial_no FROM invoices ORDER BY id DESC L=
IMIT 1");
$lastSerial =3D $stmt-&gt;fetchColumn();

if ($lastSerial) {
    $nextSerial =3D intval($lastSerial) + 1;
} else {
    $nextSerial =3D 1;
}

// Format with leading zeros (e.g. 001, 002, 003...)
$serialNo =3D str_pad($nextSerial, 3, '0', STR_PAD_LEFT);
