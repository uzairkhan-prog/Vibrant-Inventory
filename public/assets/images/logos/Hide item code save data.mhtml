require 'db.php';

// Fetch customers for selection dropdown
$stmt =3D $pdo-&gt;query("SELECT id, code, name FROM customers ORDER BY nam=
e");
$customers =3D $stmt-&gt;fetchAll(PDO::FETCH_ASSOC);

// Fetch customers for selection dropdown
$stmt =3D $pdo-&gt;query("SELECT id, hs_code FROM hs_codes ORDER BY id");
